# ----------------------------------------------------------------------------
# MarketPulse environment configuration
# Copy to .env and adjust. Never commit .env (it is gitignored).
# ----------------------------------------------------------------------------

# --- Runtime mode: "local" (laptop, no services) or "docker" (full stack) ---
MP_ENV=docker

# --- Kafka ---
MP_KAFKA_BOOTSTRAP=kafka:9092
MP_TOPIC_TICKS=market.ticks.v1
MP_TOPIC_TRADES=market.trades.v1

# --- Lakehouse (MinIO is S3-compatible; same code works on AWS S3) ---
MP_LAKE_ROOT=s3a://marketpulse-lake
MP_S3_ENDPOINT=http://minio:9000
MP_S3_ACCESS_KEY=minioadmin
MP_S3_SECRET_KEY=minioadmin
MP_DELTA_ENABLED=true

# --- Warehouse (Postgres serving layer) ---
MP_WAREHOUSE_URL=postgresql://marketpulse:marketpulse@postgres:5432/marketpulse

# --- Spark ---
MP_SPARK_MASTER=spark://spark-master:7077

# --- Generator ---
MP_GENERATOR_SEED=42
MP_GENERATOR_EVENTS_PER_SEC=200
MP_GENERATOR_ANOMALY_RATE=0.005

# --- Airflow (used by docker-compose only) ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
